<UserControl x:Class="Dtimu.DiscEditor.WPFControls.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Dtimu.DiscEditor.WPFControls"
             mc:Ignorable="d" d:Background="White" DragDrop.Drop="UserControl_Drop" AllowDrop="True" Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition MaxHeight="110"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Margin="40,0,0,0" Text="您好！" VerticalAlignment="Center" FontSize="36" FontWeight="Bold"/>
        <StackPanel Margin="20,0,0,0" Name="Templates" HorizontalAlignment="Left"
                    Grid.Row="1" Orientation="Horizontal"
                    Loaded="Templates_Loaded"/>
        <StackPanel Grid.Row="2">
            <TextBlock Margin="40,0,0,0" Text="最近的项目" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
            <StackPanel Name="RecentItemsStack" Loaded="RecentItemsStack_Loaded"/>
        </StackPanel>
    </Grid>
</UserControl>
