<UserControl x:Class="Dtimu.DiscEditor.WPFControls.DefualtEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Dtimu.DiscEditor.WPFControls"
             xmlns:dc="clr-namespace:Dtimu.DiscEditor.Core;assembly=Dtimu.DiscEditor.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:ReadBitMap x:Key="ReadBitMapC"/>
        <local:GetFileName x:Key="GetFileN"/>
        <local:SheetColorWithCounter x:Key="SheetC"/>
        <local:SheetColorWithCounterVedio x:Key="SheetCV"/>
        <local:ShowStatusC x:Key="ShowStatus"/>
        <local:ShowStatusCV x:Key="ShowStatusV"/>
        <local:ShowStatusW x:Key="ShowStatusW"/>
        <local:StringArrayConverter x:Key="StringArrayConv"/>
        <local:NullRefBackground x:Key="NullRefB"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧菜单栏 -->
        <TabControl>
            <TabItem Header="音乐">
                <Grid AllowDrop="True" 
        HorizontalAlignment="Stretch"
        Name="LeftMenus" Background="Transparent"
        DragDrop.Drop="LeftMenus_Drop"
        VerticalAlignment="Stretch"
        Margin="10,10,0,0">
                    <StackPanel>
                        <!-- 文本框样式的菜单项 -->
                        <TextBlock x:Name="INFO_IMPORTEDMEDIA"  FontSize="16" FontWeight="Bold" Foreground="Black" InputScope="Default">
                <Run Text="项目( 拖动或"/>
                <Run TextDecorations="Underline" Foreground="Blue" MouseDown="Run_MouseDown">导入</Run>
                <Run Text=")"/>
                        </TextBlock>
                        <ListBox x:Name="MEDIA" SelectionChanged="MUSIC_SelectionChanged" 
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel Orientation="Horizontal" Background="{Binding Converter={StaticResource SheetC} , ConverterParameter={StaticResource CurrentProj}}">
                                                    <Rectangle Margin="3" Height="20"
                                                       Fill="Red" Width="{Binding NoError, Converter={StaticResource ShowStatus},ConverterParameter={StaticResource CurrentProj}}"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="3"
                                                       Text="{Binding Converter={StaticResource GetFileN}}" Name="MediaItemText" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Converter={StaticResource GetFileN}}" Name="MediaItemText" />
                                        </StackPanel>
                                    </ContentControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                </Grid>

            </TabItem>
            <TabItem Header="视频">
                <Grid AllowDrop="True" 
        HorizontalAlignment="Stretch"
        Name="LeftMenus_VEDIO" Background="Transparent"
        DragDrop.Drop="LeftMenus_Drop"
        VerticalAlignment="Stretch"
        Margin="10,10,0,0">
                    <StackPanel>
                        <!-- 文本框样式的菜单项 -->
                        <TextBlock x:Name="INFO_IMPORTEDMEDIA_VEDIO"  FontSize="16" FontWeight="Bold" Foreground="Black" InputScope="Default">
                <Run Text="项目( 拖动或"/>
                <Run TextDecorations="Underline" Foreground="Blue" MouseDown="Run_MouseDown">导入</Run>
                <Run Text=")"/>
                        </TextBlock>
                        <ListBox x:Name="MEDIA_VIDEO" SelectionChanged="MUSIC_SelectionChanged" 
                         HorizontalContentAlignment="Stretch" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel Orientation="Horizontal" Background="{Binding Converter={StaticResource SheetC} , ConverterParameter={StaticResource CurrentProj}}">
                                                    <Rectangle Margin="3" Height="20"
                                                       Fill="Red" Width="{Binding NoError, Converter={StaticResource ShowStatusV},ConverterParameter={StaticResource CurrentProj}}"/>
                                                    <TextBlock TextWrapping="Wrap" Margin="3"
                                                       Text="{Binding Converter={StaticResource GetFileN}}" Name="MediaItemText" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Converter={StaticResource GetFileN}}" Name="MediaItemText" />
                                        </StackPanel>
                                    </ContentControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                </Grid>

            </TabItem>
        </TabControl>
        <!-- 右侧主内容区域 -->
        <Grid VerticalAlignment="Top" Margin="10" Grid.Column="1" HorizontalAlignment="Stretch"  Name="DetailedINFO">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Pictures[0], Converter={StaticResource ResourceKey=ReadBitMapC}}" 
               Width="150" Height="150" HorizontalAlignment="Right" Grid.Column="1"
               VerticalAlignment="Top"/>
            <!-- 章节信息 -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="标题: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox MinWidth="50" Validation.Error="TextBox_Error">
                        <TextBox.Text>
                            <Binding Path="Title" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <local:NonEmptyStringValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="艺术家: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox MinWidth="50" Validation.Error="TextBox_Error">
                        <TextBox.Text>
                            <Binding Path="Performers" Converter="{StaticResource StringArrayConv}" 
                                     NotifyOnValidationError="True"
                                     UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:NonEmptyStringValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="专辑: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox MinWidth="50" Validation.Error="TextBox_Error" >
                        <TextBox.Text>
                            <Binding Path="Album" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <local:NonEmptyStringValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="流派: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox MinWidth="50" Validation.Error="TextBox_Error">
                        <TextBox.Text>
                            <Binding Path="Genres" Converter="{StaticResource StringArrayConv}" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:NonEmptyStringValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="年份: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBox MinWidth="50" Validation.Error="TextBox_Error">
                        <TextBox.Text>
                            <Binding Path="Year" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <local:NonEmptyStringValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="时长: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Duration, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="比特率: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AudioBitrate, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="采样率: " FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AudioSampleRate, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3">
                    
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                    Margin="0,0,0,20" Grid.ColumnSpan="2">
            <Button Width="80" Height="30" Margin="10" Name="SAVE_PROJ" Click="SAVE_PROJ_Click" Content="保存项目文件"/>
        </StackPanel>
        <!-- 底部缩略图预览区域 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                    Margin="0,0,0,20" Grid.ColumnSpan="3">
            <Button Width="80" Height="30" Margin="10" Name="Export_TO_ISO" Click="Export_TO_ISO_Click" Content="导出 ISO" IsEnabled="False"/>
            <Button Width="80" Height="30" Margin="10" Name="Export_TO_Folder" Click="Export_TO_Folder_Click" Content="导出到文件夹"/>
        </StackPanel>
    </Grid>
</UserControl>
