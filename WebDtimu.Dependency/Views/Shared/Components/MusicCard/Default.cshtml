@{
    var guid = Guid.NewGuid().ToString();
}

<style>
    /* 网格容器 */
    .album-grid {
        display: grid;
        grid-auto-rows: 120px;
        gap: 0px; /* 去掉间距 */
    }

    /* 图片卡片 */
    .album-item img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        cursor: pointer;
        display: block;
    }

    /* 纯色文字卡片 */
    .album-text {
        width: 120px;
        height: 120px;
        color: white;
        font-size: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        cursor: pointer;
    }

    /* 鼠标悬浮预览框 */
    .preview-box {
        position: fixed; /* 相对于视口 */
        width: 200px;
        height: 200px;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        display: none;
        pointer-events: none;
        z-index: 999;
        background-color: black;
        opacity: 0;
        transition: opacity 0.12s ease-out;
    }

        .preview-box.show {
            display: block;
            opacity: 1;
        }

        .preview-box.hide {
            opacity: 0;
        }

        .preview-box img,
        .preview-box .preview-text {
            width: 100%;
            height: 100%;
            object-fit: cover;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 18px;
            text-align: center;
            padding: 5px;
        }

    .card-combined-base {
        position: relative;
        padding-top: 40px;
        margin-bottom: 40px;
    }
</style>

<div class="card-combined-base" id="@guid">
    <div class="card-chrome">
        <h6 class="card-title">音乐</h6>
        <div class="album-grid" style="margin-top:40px;margin-left:40px"></div>
        <div id="previewBox" class="preview-box"></div>
    </div>
</div>

<script>
    (() => {
        document.addEventListener("DOMContentLoaded", async () => {
            const cardBase = document.getElementById('@guid');
            const Size = 120;
            const PREVIEW_OFFSET = 16; // 鼠标偏移量
            const PREW = 200, PREH = 200;

            const chrome = cardBase.querySelector('.card-chrome');
            const albumGrid = chrome.querySelector('.album-grid');
            const preview = chrome.querySelector('.preview-box');

            const albumsDict = await fetch('/api/Lists/AlumbList').then(r => r.json());
            const pictureInfo = await fetch('/api/Lists/PicturesList').then(r => r.json());

            const albumsInfo = Object.entries(albumsDict).map(([key, value]) => ({
                key, ...value
            }));

            // 更新列数
            function updateGridColumns() {
                const containerWidth = albumGrid.clientWidth;
                const cols = Math.max(1, Math.floor(containerWidth / Size));
                albumGrid.style.gridTemplateColumns = `repeat(${cols}, ${Size}px)`;
                return cols;
            }

            // 渲染网格
            albumsInfo.forEach((item) => {
                const el = document.createElement("div");
                el.classList.add("album-item");
                el.style.width = Size + "px";
                el.style.height = Size + "px";

                if (!item.pictures || item.pictures.length === 0) {
                    const div = document.createElement("div");
                    div.classList.add("album-text");
                    div.textContent = item.key.toUpperCase();
                    div.style.backgroundColor = item.color || "#444";
                    el.appendChild(div);
                } else {
                    const img = document.createElement("img");
                    const hash = item.pictures[0];
                    img.src = "data:image/png;base64," + pictureInfo[hash];
                    el.appendChild(img);
                }

                albumGrid.appendChild(el);

                // 鼠标悬浮显示预览
    function showPreview(e) {
        preview.style.display = "block";

        if (!item.pictures || item.pictures.length === 0) {
            preview.innerHTML = `<div class="preview-text" style="background:${item.color || "#444"}">${item.key}</div>`;
        } else {
            const hash = item.pictures[0];
            preview.innerHTML = `<img src="data:image/png;base64,${pictureInfo[hash]}" />`;
        }

        // 获取 item 相对于视口的位置
        const rect = el.getBoundingClientRect();

        // 获取滚动偏移
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollLeft = window.scrollX || document.documentElement.scrollLeft;

        // 计算 item 中心坐标（页面坐标）
        let centerX = rect.left + rect.width / 2 + scrollLeft;
        let centerY = rect.top + rect.height / 2 + scrollTop;

        // 预览框居中显示在 item 中心附近
        let left = centerX - PREW / 2;
        let top = centerY - PREH / 2;

        // 可选微调，让预览框稍微偏右下
        left += 0; // 可以改成 e.offsetX 或其他偏移
        top += 0;  // 同上

        preview.style.left = left + "px" ;
        preview.style.top = top  - window.scrollY + "px";

        preview.classList.add("show");
        preview.classList.remove("hide");
    }

                function hidePreview() {
                    preview.classList.remove("show");
                    preview.classList.add("hide");
                    clearTimeout(preview._hideTimer);
                    preview._hideTimer = setTimeout(() => {
                        if (preview.classList.contains("show")) return;
                        preview.style.display = "none";
                    }, 150);
                }

                el.addEventListener("mouseenter", showPreview);
                el.addEventListener("mousemove", showPreview);
                el.addEventListener("mouseleave", hidePreview);
            });

            // 动态高度
            function updateContainerHeight() {
                const cols = updateGridColumns();
                const rows = Math.ceil(albumGrid.children.length / cols);
                const outres = rows * Size;
                cardBase.style.height = outres + "px";
                chrome.style.height = outres + "px";
            }

            updateContainerHeight();

            let resizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateContainerHeight, 100);
            });
        });
    })();
</script>
