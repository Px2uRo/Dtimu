@{
    var guid = Guid.NewGuid().ToString();
}
<style>
    .card-combined-base {
        position: relative; /* 内部绝对或 grid 布局参考 */
        padding-top: 40px; /* 保留标题 */
        margin-bottom: 40px; /* 避免组件叠加 */
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 160px);
        grid-auto-rows: 90px;
        gap: 20px;
    }

    .video-card-content img {
        width: 160px;
        height: 90px;
        transition: 0.1s ease;
        cursor: pointer;
        display: block;
    }
</style>

<div class="card-combined-base" id="@guid">
    <div class="card-chrome">
        <h6 class="card-title">视频</h6>
        <div class="video-grid" style="margin-top:40px;margin-left:20px">

        </div>
    </div>
</div>

<script>
    (() => {
        document.addEventListener("DOMContentLoaded", async () => {
            const cardBase = document.getElementById('@guid');
            const grid = cardBase.querySelector(".video-grid");
            const chrome = cardBase.querySelector(".card-chrome");

            try {
                const response = await fetch("/api/Lists/VideoList");
                if (!response.ok) throw new Error("请求失败");
                const videos = await response.json();

                grid.innerHTML = ""; // 清空旧内容

                videos.forEach(video => {
                    if (!video.gallery || video.gallery.length === 0) return;

                    const div = document.createElement("div");
                    div.className = "video-card-content";

                    const img = document.createElement("img");
                    let currentIndex = 0;
                    img.src = "data:image/png;base64," + video.gallery[currentIndex];
                    img.alt = video.title || "视频";

                    // 点击跳转
                    img.onclick = () => {
                        if (!video.filePath) return;
                        window.location.href = "/files/" + video.filePath.replace(/\\/g, "/");
                    };

                    // 鼠标滑动换图
                    let lastX = null;
                    img.addEventListener("mousemove", (e) => {
                        if (lastX === null) { lastX = e.offsetX; return; }
                        const deltaX = e.offsetX - lastX;
                        if (Math.abs(deltaX) >= 16) {
                            currentIndex = (currentIndex + (deltaX > 0 ? 1 : -1) + video.gallery.length) % video.gallery.length;
                            img.src = "data:image/png;base64," + video.gallery[currentIndex];
                            lastX = e.offsetX;
                        }
                    });
                    img.addEventListener("mouseleave", () => { lastX = null; });

                    div.appendChild(img);
                    grid.appendChild(div);
                });

                // 动态计算父容器高度
                function updateContainerHeight() {
                    const rows = Math.ceil(grid.children.length / Math.floor(grid.clientWidth / 160));
                    const itemHeight = 90;
                    const gap = 20;
                        
                    const outres = rows * itemHeight + (rows) * gap +60;
                    cardBase.style.height = outres + "px";
                    chrome.style.height = outres + "px";


                }

                // 初次计算
                updateContainerHeight();

                // 窗口 resize 防抖
                let resizeTimer;
                window.addEventListener("resize", () => {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(updateContainerHeight, 100);
                });

            } catch (err) {
                chrome.textContent = "加载视频失败：" + err.message;
                console.error(err);
            }
        });
    })();
</script>
