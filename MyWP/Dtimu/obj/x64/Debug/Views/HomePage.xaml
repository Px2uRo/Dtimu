<Page
    x:Class="Dtimu.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dtimu" xmlns:ctrl="using:Dtimu.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <Grid>
            <StackPanel>
                <StackPanel>
                    <TextBlock Text=" 最近的项目 " FontSize="24" Margin="10">

                    </TextBlock>
                    <ctrl:RecentItemPanel x:ConnectionId='2' x:Name="RIP">

                    </ctrl:RecentItemPanel>
                </StackPanel>
                <ListBox x:ConnectionId='1' x:Name="MenuList" HorizontalAlignment="Stretch"
                 SelectionMode="Single"
                                                             >
                    <ListBoxItem Content="视频" Tag="Video"/>
                    <ListBoxItem Content="音乐" Tag="Music"/>
                    <ListBoxItem Content="图片" Tag="Pictures"/>
                </ListBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:ConnectionId='3' Icon="Setting" Label="设置"                           />
        </CommandBar>
    </Page.BottomAppBar>
</Page>

