<UserControl x:Class="DiscViewer.SmallControls.VedioDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.SmallControls" MinWidth="300" Height="100"
             mc:Ignorable="d" xmlns:core="clr-namespace:Dtimu.Core;assembly=MediaReader"
             xmlns:conv="clr-namespace:DiscViewer.BindingConvertors"
             d:Background="White" MouseDown="UserControl_MouseDown" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave">
    <UserControl.Resources>
        <conv:TextToUpper x:Key="toUpper"/>
        <conv:TextToFUpper x:Key="toFUpper"/>
    </UserControl.Resources>
    <Grid>
        <Rectangle Fill="Black" Name="BackGroundRect" Opacity="0"/>
        <Grid MouseMove="Grid_MouseMove">
            <Border Background="Aqua" Width="160" Height="90" Margin="2" 
                    HorizontalAlignment="Left" MouseDown="UserControl_MouseDown" Name="GalleryBorder">
            </Border>
            <Grid Background="#AF000000" Width="160" Margin="2,2,2,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20">
                <TextBlock Text="{Binding Duration}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <Grid Margin="165,0,0,0" MouseDown="UserControl_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"  FontSize="22" TextWrapping="Wrap" Text="{Binding Title, Converter={StaticResource toUpper}}" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Description}" VerticalAlignment="Top" Grid.Row="1"/>
            <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Author, Converter={StaticResource toFUpper}}" VerticalAlignment="Top" Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
