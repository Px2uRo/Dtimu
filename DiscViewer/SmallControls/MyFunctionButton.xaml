<UserControl x:Class="DiscViewer.SmallControls.MyFunctionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.SmallControls"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="100">
    <Border Background="{Binding ButtonBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Height="24"
            Margin="0,0,0,5"
            VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
            <Rectangle Width="15" Height="15" Margin="5,0,0,0"
                       Fill="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock Text="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="5,0,5,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
