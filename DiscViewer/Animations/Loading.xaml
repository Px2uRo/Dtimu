<UserControl x:Class="DiscViewer.Animations.Loading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.Animations"
             mc:Ignorable="d" VerticalAlignment="Center" HorizontalAlignment="Center"
             Height="400" Width="400">
    <Canvas Name="MyCanvas">
        <!-- 定义方块 -->
        <Rectangle Name="MovingRectangle" Width="50" Height="50" Fill="DodgerBlue" />

        <!-- 动画 -->
        <Canvas.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <!-- 第一段：从 (50,50) 到 (350,50) -->
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Left)"
                            From="50" To="350" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Top)"
                            From="50" To="50" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- 第二段：从 (350,50) 到 (350,350) -->
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Left)"
                            From="350" To="350" Duration="0:0:0.5" BeginTime="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Top)"
                            From="50" To="350" Duration="0:0:0.5" BeginTime="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- 第三段：从 (350,350) 到 (50,350) -->
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Left)"
                            From="350" To="50" Duration="0:0:0.5" BeginTime="0:0:1">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Top)"
                            From="350" To="350" Duration="0:0:0.5" BeginTime="0:0:1">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- 第四段：从 (50,350) 到 (50,50) -->
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Left)"
                            From="50" To="50" Duration="0:0:0.5" BeginTime="0:0:1.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation 
                            Storyboard.TargetName="MovingRectangle" 
                            Storyboard.TargetProperty="(Canvas.Top)"
                            From="350" To="50" Duration="0:0:0.5" BeginTime="0:0:1.5">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Canvas.Triggers>
    </Canvas>
</UserControl>
