<Window x:Class="DiscViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" xmlns:views="clr-namespace:DiscViewer.Views"
        Title="Disc ToolkIt for MUtilMedia" Height="450" Width="800">
    <Grid>
        <Border x:Name="mainBorder">
            <views:StartPage/>
        </Border>
        <Border Name="flyo" />
        <Grid Name="BottonGrid" Background="Transparent" MouseLeave="BottonGrid_MouseLeave"
               MouseEnter="Grid_MouseEnter"  VerticalAlignment="Bottom"  Height="80">
            <Grid VerticalAlignment="Bottom" Height="61">
                <views:PlayingBar/>
            </Grid>
        </Grid>
    </Grid>
</Window> 
