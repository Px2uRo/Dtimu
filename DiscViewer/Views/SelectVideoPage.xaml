<UserControl x:Class="DiscViewer.Views.SelectVideoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.Views"
             mc:Ignorable="d" xmlns:sc="clr-namespace:DiscViewer.SmallControls"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer 
        VerticalScrollBarVisibility="Auto" 
        Name="SCV" 
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Stretch"
        IsDeferredScrollingEnabled="True" Focusable="False">
        <Grid>
            <UniformGrid HorizontalAlignment="Stretch" VerticalAlignment="Top" Name="Wraps" >

            </UniformGrid>
            <Button Name="Back" Background="Transparent" BorderBrush="Transparent" Height="50" Click="Back_Click" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image Source="..\Images\PageBack.png"/>
            </Button>
        </Grid>
    </ScrollViewer>
</UserControl>
