<UserControl x:Class="DiscViewer.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.Views"
             mc:Ignorable="d" d:Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Border Background="#50000000" MouseDown="AlumbBorder_MouseDown"  Name="AlumbBorder" Grid.RowSpan="2" Grid.Column="1" Margin="3" Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}" Grid.Row="1">
            <Grid>
                <Rectangle Fill="Magenta" x:Name="RECT_Music"/>
                <Image VerticalAlignment="Center" 
                       HorizontalAlignment="Center" Source="..\Images\Musics.png" Height="200" Width="200"/>
                <TextBlock Name="Info_Music" Foreground="Cyan"  VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
        <Border Background="#50000000" MouseDown="VedioBorder_MouseDown"  Name="VedioBorder" Grid.Column="2" Margin="3" Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}" Grid.Row="1">
            <Grid>
                <Rectangle Fill="Red" Name="RECT_Vedio"/>
                <Image VerticalAlignment="Center" 
                       HorizontalAlignment="Center" Source="..\Images\Vedio.png" Height="80" Width="80"/>
                <TextBlock Name="Info_Vedio" Foreground="White" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
        <Border Background="#50000000" MouseDown="PictruesBorder_MouseDown"  Name="PictruesBorder" Grid.Column="2" Margin="3" Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}" Grid.Row="2">
            <Grid>
                <Rectangle Fill="Green" Name="RECT_Pic"/>
                <Image VerticalAlignment="Center" 
           HorizontalAlignment="Center" Source="..\Images\Pictrues.png" Height="80" Width="80"/>
                <TextBlock Name="Info_Pictrue" Foreground="White" VerticalAlignment="Bottom"/>
            </Grid>

        </Border>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="欢迎！"
                   FontSize="56" FontWeight="Bold" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
