<UserControl x:Class="DiscViewer.Views.FlyoputView.AlumbInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.Views.FlyoputView"
             mc:Ignorable="d" Background="White" VerticalAlignment="Bottom"  HorizontalAlignment="Stretch"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Name="anys">
            <Grid Name="remvb" Margin="20,10,0,0" Width="125" Height="125" d:Background="Aqua">
                <Image Width="125" Height="125" Name="AlbumImage"/>
            </Grid>
            <Grid Margin="10,0,0,10" Height="55" VerticalAlignment="Bottom">
                <TextBlock d:Text="114514" FontSize="24" FontWeight="Bold" Name="TitleBox"/>
                <TextBlock d:Text="114514" FontSize="16" Name="PerformancerBox" VerticalAlignment="Bottom"/>
            </Grid>
        </StackPanel>
        <StackPanel Name="Musics" Grid.Row="2"/>
    </Grid>
</UserControl>
