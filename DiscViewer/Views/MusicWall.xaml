<UserControl x:Class="DiscViewer.Views.MusicWall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiscViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#0000CF">
        <Border>
            <Border.OpacityMask>
                <RadialGradientBrush>
                    <!-- Center is transparent (highlighted area) -->
                    <GradientStop Color="Transparent" Offset="0.9" />
                    <!-- Edge gradually fades to black -->
                    <GradientStop Color="Black" Offset="1.6" />
                </RadialGradientBrush>
            </Border.OpacityMask>

            <!-- Black overlay that will be used with OpacityMask to create vignette effect -->
            <Border.Background>
                <SolidColorBrush Color="Black" />
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
