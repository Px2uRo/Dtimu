<Window x:Class="Dtimu.Launcher.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dtimu.Launcher"
        mc:Ignorable="d" WindowStyle="ToolWindow" DataContext="{DynamicResource DesInfo}"
        Title="DTIMU TookIt for MUltiMedia 光盘" Width="500" Height="350" Loaded="Window_Loaded">
    <Window.Resources>
        <local:InfoInstance x:Key="DesInfo"/>
        <local:BoolToVisibility x:Key="BTV"/>
        <!-- 自定义 RadioButton 样式 -->
        <Style x:Key="ColoredRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OuterBorder" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <!-- 左侧彩色方块 -->
                                <Border x:Name="ColoredRectangle" 
                                        Width="3" Height="20"
                                        VerticalAlignment="Center"
                                        Background="Gray"
                                        Margin="0,0,5,0"/>

                                <!-- RadioButton 内容 -->
                                <ContentPresenter VerticalAlignment="Center" Margin="-4,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 触发器和动画 -->
                        <ControlTemplate.Triggers>
                            <!-- 选中时颜色动画 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ColoredRectangle"
                                                           Storyboard.TargetProperty="(Border.Background).Color"
                                                           To="Blue" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ColoredRectangle"
                                                             Storyboard.TargetProperty="Height"
                                                             To="25" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ColoredRectangle"
                                                           Storyboard.TargetProperty="(Border.Background).Color"
                                                           To="Gray" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ColoredRectangle"
                                                             Storyboard.TargetProperty="Height"
                                                             To="20" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- 悬停时背景变灰 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="OuterBorder"
                                                           Storyboard.TargetProperty="(Border.Background).Color"
                                                           To="#D3D3D3" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="OuterBorder"
                                                           Storyboard.TargetProperty="(Border.Background).Color"
                                                           To="Transparent" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/Nature.jpg"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 左侧菜单栏 -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,10,0" >
            <TextBlock Text=" 目 录 " Width="75" FontWeight="Thin" Margin="10,5,0,0" Foreground="White" HorizontalAlignment="Left" Background="Black"/>
            <RadioButton Style="{DynamicResource ColoredRadioButton}" IsChecked="True" Name="WelcomeRadio" Content="简介" FontSize="14" Margin="0,5" />
            <RadioButton Style="{DynamicResource ColoredRadioButton}"  Name="INETFW" Content="安装运行库" FontSize="14" Margin="0,5"/>
            <RadioButton Style="{DynamicResource ColoredRadioButton}"  Name="Explore" Content="浏览此光盘" FontSize="14" Margin="0,5"/>
            <RadioButton Style="{DynamicResource ColoredRadioButton}"  Name="Abou" Content="关于 DTIMU" FontSize="14" Margin="0,5"/>
        </StackPanel>

        <!-- 右侧内容 -->
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch" Visibility="{Binding ElementName=WelcomeRadio, Path=IsChecked,Converter={StaticResource BTV}}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,10">简介</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding Descrition}"/>
            </StackPanel>
            <TextBlock MouseDown="EnterDTIMU_MouseDown" Name="EnterDTIMU" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="30" Background="Transparent" Text=">" FontWeight="Bold" FontSize="120"/>
            
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding ElementName=INETFW, Path=IsChecked,Converter={StaticResource BTV}}">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Margin="10" TextWrapping="Wrap" Text="   如果你能看到这个文字，说明你的系统已经安装了 .NET Framework 3.5，但该程序使用 .NET Framework 4.0, 以防万一，我们仍然推荐安装，如果安装好后仍无法运行，请到关于页面联系我。"/>
                    <Button Name="InstallNET" Click="InstallNET_Click" Width="80" Height="80">
                        <Button.Content>
                            <Image Source="pack://application:,,,/Images/NET4.jpeg" Margin="10"/>
                        </Button.Content>
                    </Button>
                    <TextBlock Text=".NET Framework 4.0" HorizontalAlignment="Center" Margin="3"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding ElementName=Explore, Path=IsChecked,Converter={StaticResource BTV}}">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Button Click="Explorer_Click" Name="Explorer" Width="80" Height="80">
                        <Button.Content>
                            <Image Source="pack://application:,,,/Images/FileExp.png" Margin="10"/>
                        </Button.Content>
                    </Button>
                    <TextBlock Text="资源管理器" HorizontalAlignment="Center" Margin="3"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding ElementName=Abou, Path=IsChecked,Converter={StaticResource BTV}}">
            <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,10">
                Disc TookIt for MUtilMedia</TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                一个多媒体光盘工具
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                由微软粉开发。
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                <Run>电子邮件: </Run>
                <Run Foreground="Blue">hongyu233@outlook.com</Run>
            </TextBlock>
            <TextBlock Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10">
                免责声明：光盘内其他内容（如歌曲）归原作者所有，出现版权问题，Dtimu 概不负责！
            </TextBlock>
            <TextBlock FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10">
                库引用：NAudio (MIT Linsence)
            </TextBlock>
            <TextBlock Name="VersionInfo" TextWrapping="Wrap" Margin="0,0,0,10">
                
            </TextBlock>
            <Button Name="ClearDtimu" Content=" 清理 Dtimu " Click="ClearDtimu_Click" TextBlock.Foreground="Red" Margin="10"/>
        </StackPanel>

        <!-- 底部复选框和按钮 -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button Content="关闭" Margin="5" Width="75" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Button_Click"/>
        </DockPanel>
        <DockPanel LastChildFill="False"  Grid.ColumnSpan="2">
            <TextBlock DockPanel.Dock="Top"
                       FontSize="30" 
                       FontWeight="Bold" 
                       Foreground="Black"
                       Margin="10,10,0,5" Text="{Binding CDTitle}"></TextBlock>
        </DockPanel>
    </Grid>
</Window>
