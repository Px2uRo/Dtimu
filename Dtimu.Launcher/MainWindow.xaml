<Window x:Class="Dtimu.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dtimu.Launcher"
        mc:Ignorable="d"
        Title="Dtimu ToolkIt for MUtilmedia" Width="500" Height="350">
    <Grid>
        <TextBlock Text="已经安装 Dtimu 了吗？"  Margin="20"/>
        <CheckBox Content="浏览光盘同时安装 Dtimu" HorizontalAlignment="Center" Name="InstallCheck" Checked="InstallCheck_Checked" Unchecked="InstallCheck_Unchecked" VerticalAlignment="Center"/>
        <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Name="CTNBtn" Content=" 继续（不安装 Dtimu） " Margin="5" Click="CTNBtn_Click"/>
    </Grid>
</Window>
